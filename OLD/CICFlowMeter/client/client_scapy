import pandas as pd
import time
import random
from scapy.all import *

SERVER_PORT = 9000


def create_tcp_handshake(src_ip, dst_ip, sport, dport):
    seq = random.randint(0, 100000)

    syn = IP(src=src_ip, dst=dst_ip) / TCP(sport=sport, dport=dport, flags="S", seq=seq)
    synack = sr1(syn, timeout=1, verbose=0)

    if synack is None:
        return None, None

    ack = IP(src=src_ip, dst=dst_ip) / TCP(
        sport=sport,
        dport=dport,
        flags="A",
        seq=synack.ack,
        ack=synack.seq + 1
    )
    send(ack, verbose=0)

    return synack.ack, synack.seq + 1


def generate_flow(row, ip_client, ip_server):
    sport = random.randint(1024, 65535)

    total_fwd = int(row["Total Fwd Packets"])
    total_bwd = int(row["Total Backward Packets"])
    duration = float(row["Flow Duration"]) / 1e6

    mean_size = float(row["Fwd Packet Length Mean"])
    std_size = float(row["Fwd Packet Length Std"])

    if total_fwd <= 0:
        return

    iat = duration / total_fwd if total_fwd > 0 else 0.01

    seq, ack = create_tcp_handshake(ip_client, ip_server, sport, SERVER_PORT)

    if seq is None:
        print("[!] Handshake fallito")
        return

    print(f"[FLOW] {total_fwd} pkt, durata {duration:.2f}s")

    for i in range(total_fwd):
        size = max(1, int(random.gauss(mean_size, std_size)))

        payload = Raw(load=bytes(size))

        pkt = IP(src=ip_client, dst=ip_server) / TCP(
            sport=sport,
            dport=SERVER_PORT,
            flags="PA",
            seq=seq,
            ack=ack
        ) / payload

        send(pkt, verbose=0)

        seq += size

        # simulazione backward (ricezione ACK)
        resp = sniff(
            filter=f"tcp and src host {ip_server} and dst port {sport}",
            timeout=0.1,
            count=1
        )

        time.sleep(iat)


def start_client(csv_file, ip_client, ip_server):
    df = pd.read_csv(csv_file)

    flows = df[
        ((df["Source IP"] == ip_client) & (df["Destination IP"] == ip_server)) |
        ((df["Source IP"] == ip_server) & (df["Destination IP"] == ip_client))
    ]

    print(f"[+] Flussi trovati: {len(flows)}")

    for _, row in flows.iterrows():
        generate_flow(row, ip_client, ip_server)


if __name__ == "__main__":
    import sys

    if len(sys.argv) != 4:
        print("Uso: python client_scapy.py flows.csv IPclient IPserver")
        exit(1)

    start_client(sys.argv[1], sys.argv[2], sys.argv[3])