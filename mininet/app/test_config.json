{
  "test_config": {
    "comment": "Configurazione parametri per test implementations",
    "port": 9000,
    "duration": 5,
    "timeout_multiplier": 2.0,
    "server_startup_timeout": 5,
    "localhost": "127.0.0.1"
  },
  "implementations": {
    "tcp_simple": {
      "enabled": true,
      "description": "Socket TCP nativi Python",
      "packets_per_second": 10
    },
    "scapy_burst": {
      "enabled": true,
      "description": "Burst ottimizzati con Scapy",
      "requires_sudo": false
    },
    "flow_emulator": {
      "enabled": true,
      "description": "Emulazione con controllo statistiche",
      "requires_sudo": false
    }
  },
  "output": {
    "verbose": false,
    "save_json": true,
    "json_file": "test_results.json",
    "colorized": true
  },
  "advanced": {
    "parallel_tests": false,
    "retry_failed": false,
    "retry_count": 1,
    "cleanup_on_error": true
  }
}
