{
  "global": {
    "seed": 42,
    "max_parallel_flows": 128,
    "connect_timeout": 10.0,
    "socket_timeout": 30.0,
    "post_send_wait": 0.25,
    "initial_delay_s": 0.0,
    "close_delay_ms": 0.0,
    "tcp_nodelay": true,
    "send_buffer": null,
    "recv_buffer": null,
    "mss_hint": null,
    "chunk_size": 1448,
    "reverse_chunk_size": 1448,
    "use_tcp_buffers_from_init_win": true,
    "use_tcp_maxseg_from_seg_size_min": true
  },
  "models": {
    "packet_size_model": "csv_stats",
    "payload_mean_scale": 1.0,
    "payload_std_scale": 1.0,
    "payload_min_scale": 1.0,
    "payload_max_scale": 1.0,
    "fwd_payload_mean_scale": null,
    "fwd_payload_std_scale": null,
    "bwd_payload_mean_scale": null,
    "bwd_payload_std_scale": null,
    "shuffle_payload_sizes": true,
    "use_fwd_iat": true,
    "use_flow_iat_fallback": true,
    "use_active_idle": true,
    "iat_scale": 1.0,
    "iat_std_scale": 1.0,
    "fwd_iat_scale": null,
    "duration_scale": 1.0,
    "jitter_fraction": 0.02,
    "burst_probability": 0.0,
    "burst_factor": 2.0,
    "idle_threshold_ms": 40.0,
    "server_delay_scale": 1.0,
    "bwd_request_strategy": "auto"
  },
  "flows": {
    "0": {
      "iat_scale": 1.0,
      "payload_std_scale": 1.0,
      "tcp_nodelay": true
    },
    "192.168.1.10:52152->192.168.1.20:443": {
      "reverse_chunk_size": 512,
      "bwd_payload_std_scale": 1.2
    }
  }
}
