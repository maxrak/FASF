{
  "description": "Network topology for Mininet - Private subnets + Monitoring Switch + Internet",
  "architecture": "private_subnets_monitoring_switch_internet",
  "subnets": [
    {
      "type": "private_subnet",
      "network": "10.0.0.0/8",
      "switch_name": "s10_0_0_0",
      "hosts": [
        "10.0.2.15",
        "10.0.2.2"
      ],
      "num_hosts": 2
    }
  ],
  "monitoring_switch": {
    "name": "s_monitoring",
    "type": "aggregation_switch",
    "connects_to": [
      "s10_0_0_0"
    ],
    "purpose": "Aggregation switch for all private subnets, connected to router"
  },
  "routers": [
    {
      "id": "gateway_router",
      "type": "central_gateway",
      "connects_monitoring": "s_monitoring",
      "connects_internet": null,
      "purpose": "Route traffic between monitoring switch (private subnets) and Internet"
    }
  ],
  "flows": [
    {
      "src_ip": "10.0.2.15",
      "dst_ip": "10.0.2.2",
      "src_ports": [
        "45678"
      ],
      "dst_ports": [
        "9000"
      ],
      "flow_count": 1
    },
    {
      "src_ip": "10.0.2.2",
      "dst_ip": "10.0.2.15",
      "src_ports": [
        "50000"
      ],
      "dst_ports": [
        "9000"
      ],
      "flow_count": 1
    }
  ],
  "statistics": {
    "total_ips": 2,
    "private_subnets": 1,
    "public_ips": 0,
    "total_flows": 2
  },
  "probe": {
    "name": "probe",
    "mode": "ovs_mirror",
    "capture_file": "pcap/capture.pcap",
    "mirror_switches": [
      "s_monitoring"
    ],
    "deduplication": true
  }
}